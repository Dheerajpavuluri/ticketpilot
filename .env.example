# Pick one provider. With no key set, TicketPilot runs the offline rules engine.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic        # anthropic | openai | offline (default: whichever key is set)
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# OPENAI_MODEL=gpt-4o-mini

# Policy
AUTO_SEND_CONFIDENCE=0.8
REFUND_REVIEW_LIMIT=100

# Optional: USD per million tokens, to show cost in the dashboard
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0
